# ── Data and auth ───────────────────────────────────────────────
# Leave all three Supabase values empty to run in local demo mode
# (in-memory store + signed demo session, no external services).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Force a mode instead of auto-detecting: memory | supabase
UNIFLOW_DATA_MODE=

# Signs the demo-mode session cookie. Use a long random string in any shared deployment.
DEMO_SESSION_SECRET=change-me-to-a-long-random-string
# Used by `npm run db:seed` when --password isn't passed.
DEMO_USER_PASSWORD=

# ── AI agent ────────────────────────────────────────────────────
# Server only. Without a key the built-in deterministic planner runs the same tools.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Force a mode: llm | scripted
AGENT_MODE=

# ── Sandbox payment rail ────────────────────────────────────────
# Simulated provider latency, so the "executing" state is visible in demos.
SANDBOX_LATENCY_MS=600
# Set to 1 to rehearse the failed-payment path.
SANDBOX_FORCE_FAILURE=0
